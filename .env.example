# Application & Auth Secrets
SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=64_character_hex_encryption_key_here

# OpenRouter & AI Service Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payment Gateway
STRIPE_SECRET_KEY=your_stripe_secret_key_here
CORS_ORIGINS= 
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here
